{
  "expo": {
    "name": "Amana",
    "slug": "amana",
    "owner": "hkhatib005",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "islamicapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.hatemkhatib.amana",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.islamicapp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D4A017",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Amana uses your location to calculate accurate prayer times and the Qibla direction for where you are.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Amana uses your device's compass and motion sensors to point the Qibla direction toward the Kaaba."
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "NextPrayerWidget",
              "displayName": "Next Prayer",
              "description": "Shows the current and next prayer with its time.",
              "supportedFamilies": [
                "systemSmall",
                "accessoryCircular"
              ]
            },
            {
              "name": "PrayerTimesWidget",
              "displayName": "Prayer Times",
              "description": "Today's five prayer times, with the current one highlighted.",
              "supportedFamilies": [
                "systemMedium"
              ]
            },
            {
              "name": "QiblaWidget",
              "displayName": "Qibla",
              "description": "The Qibla direction and distance to the Kaaba from your location.",
              "supportedFamilies": [
                "systemSmall"
              ]
            },
            {
              "name": "DailyVerseWidget",
              "displayName": "Daily Verse",
              "description": "A new Qur'an verse each day.",
              "supportedFamilies": [
                "systemMedium"
              ]
            },
            {
              "name": "AdhkarWidget",
              "displayName": "Adhkar",
              "description": "The morning or evening adhkar opener.",
              "supportedFamilies": [
                "systemMedium"
              ]
            },
            {
              "name": "TrackerWidget",
              "displayName": "Prayer Tracker",
              "description": "Today's completed prayers and your streak.",
              "supportedFamilies": [
                "systemSmall"
              ]
            }
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.hatemkhatib.amana.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.hatemkhatib.amana"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "83b264bf-ddc0-4f89-8251-64d2266ae0e1"
      }
    }
  }
}
